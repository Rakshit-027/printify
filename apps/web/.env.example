# PostgreSQL Database Connection URL (configured for connection pooling)
DATABASE_URL="postgresql://printflow_user:SuperSecurePassword123@localhost:5432/printflow_db?schema=public&connection_limit=10"

# Application Environment & Base URLs
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets
JWT_SECRET="replace-with-a-64-character-random-hex-string-for-production"
SESSION_MAX_AGE_SECONDS=604800 # 7 days

# Microsoft Azure Blob Storage (Central India)
AZURE_STORAGE_ACCOUNT_NAME="printflowstorage"
AZURE_STORAGE_ACCOUNT_KEY="your-azure-storage-account-key"
AZURE_STORAGE_CONTAINER_NAME="printflow-customer-documents"
AZURE_SAS_EXPIRY_MINUTES=15

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayTestKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# System Device Registration
DEVICE_ENROLLMENT_SECRET="system-wide-salt-for-device-tokens"
